# Build environment for portable Linux release binaries: Ubuntu 22.04 (glibc 2.35), so the
# result runs on Ubuntu 22.04+, Debian 12+, Fedora 36+, SteamOS and the like.
# The compiler is the repository's portable LLVM toolchain (mounted, see build-linux.sh);
# Ubuntu provides glibc and the SDL/X11/Wayland headers. libstdc++ comes from GCC 13 (Ubuntu
# Toolchain PPA, built for 22.04): the prebuilt Dawn needs GCC 13's libstdc++, which is linked
# statically, so users need nothing newer than glibc 2.35.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common gpg-agent \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git make pkg-config python3 file patchelf \
        g++-13 libstdc++-13-dev \
        zlib1g-dev libpng-dev \
        libasound2-dev libpulse-dev libaudio-dev libjack-dev libsndio-dev \
        libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxfixes-dev libxi-dev \
        libxss-dev libxtst-dev libxkbcommon-dev libdrm-dev libgbm-dev \
        libgl1-mesa-dev libgles2-mesa-dev libegl1-mesa-dev \
        libdbus-1-dev libibus-1.0-dev libudev-dev libusb-1.0-0-dev \
        libpipewire-0.3-dev libwayland-dev libdecor-0-dev \
        libicu70 \
    && rm -rf /var/lib/apt/lists/*
